{
    "name": "my-vendor/everything-yaml-bundle",
    "description": "MyVendorEverythingYamlBundle for Symfony",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "doctrine",
        "symfony-ux"
    ],
    "authors": [
        {
            "name": "Jane Doe",
            "email": "jane@example.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/config": "^7.4.17 || ^8.1.5",
        "symfony/console": "^7.4.17 || ^8.1.5",
        "symfony/dependency-injection": "^7.4.17 || ^8.1.5",
        "symfony/framework-bundle": "^7.4.17 || ^8.1.5",
        "symfony/http-foundation": "^7.4.17 || ^8.1.5",
        "symfony/http-kernel": "^7.4.17 || ^8.1.5",
        "symfony/routing": "^7.4.17 || ^8.1.5",
        "symfony/stimulus-bundle": "^2.13 || ^3.0",
        "symfony/twig-bundle": "^7.4.17 || ^8.1.5",
        "symfony/yaml": "^7.4.17 || ^8.1.5",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.18 || ^3.0",
        "doctrine/orm": "^3.4",
        "friendsofphp/php-cs-fixer": "^3.92",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0.9",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "symfony/asset-mapper": "^7.4.17 || ^8.1.5",
        "symfony/browser-kit": "^7.4.17 || ^8.1.5",
        "symfony/error-handler": "^7.4.17 || ^8.1.5",
        "symfony/event-dispatcher": "^7.4.17 || ^8.1.5",
        "symfony/filesystem": "^7.4.17 || ^8.1.5",
        "symfony/translation": "^7.4.17 || ^8.1.5"
    },
    "conflict": {
        "doctrine/orm": "<3.4"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "To store the greetings with Doctrine ORM"
    },
    "autoload": {
        "psr-4": {
            "MyVendor\\EverythingYamlBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyVendor\\EverythingYamlBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse",
        "qa": [
            "@test",
            "@phpstan",
            "@cs"
        ],
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "cs": "Checks the coding standards (PHP-CS-Fixer)",
        "cs:fix": "Fixes the coding standards (PHP-CS-Fixer)",
        "phpstan": "Runs the static analysis (PHPStan)",
        "qa": "Runs every quality check",
        "test": "Runs the tests (PHPUnit)"
    }
}
