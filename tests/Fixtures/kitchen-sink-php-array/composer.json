{
    "name": "acme/php-array-kitchen-sink-bundle",
    "description": "AcmePhpArrayKitchenSinkBundle for Symfony",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "kitchen-sink"
    ],
    "authors": [
        {
            "name": "Jane Doe",
            "email": "jane@example.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/config": "^7.4.17 || ^8.1.5",
        "symfony/dependency-injection": "^7.4.17 || ^8.1.5",
        "symfony/http-foundation": "^7.4.17 || ^8.1.5",
        "symfony/http-kernel": "^7.4.17 || ^8.1.5",
        "symfony/routing": "^7.4.17 || ^8.1.5"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.92",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0.9",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "symfony/browser-kit": "^7.4.17 || ^8.1.5",
        "symfony/error-handler": "^7.4.17 || ^8.1.5",
        "symfony/filesystem": "^7.4.17 || ^8.1.5",
        "symfony/framework-bundle": "^7.4.17 || ^8.1.5"
    },
    "autoload": {
        "psr-4": {
            "Acme\\PhpArrayKitchenSinkBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Acme\\PhpArrayKitchenSinkBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "kitchen-sink": "echo kitchen-sink",
        "lint": [
            "@php -l src/",
            "@test"
        ],
        "phpstan": "phpstan analyse",
        "qa": [
            "@test",
            "@lint",
            "@phpstan",
            "@cs"
        ],
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "cs": "Checks the coding standards (PHP-CS-Fixer)",
        "cs:fix": "Fixes the coding standards (PHP-CS-Fixer)",
        "kitchen-sink": "Checks the kitchen sink",
        "phpstan": "Runs the static analysis (PHPStan)",
        "qa": "Runs every quality check",
        "test": "Runs the tests (PHPUnit)"
    }
}
