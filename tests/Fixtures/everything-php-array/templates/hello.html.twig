{#
 # Greets people, rendered by Acme\EverythingPhpArrayBundle\Controller\HelloController.
 #
 # Variables:
 #   greeting  string  the greeting, e.g. "Hello Jane!"
 #
 # It is a fragment, without layout, so applications can display it anywhere. Override it in the
 # templates/bundles/AcmeEverythingPhpArrayBundle/hello.html.twig file of your application,
 # or only its "title" block by extending '@!AcmeEverythingPhpArray/hello.html.twig'.
 #}
<section class="acme-everything-php-array-hello">
    <h1 class="acme-everything-php-array-hello__title">{% block title %}{{ 'Welcome!'|trans({}, 'AcmeEverythingPhpArray') }}{% endblock %}</h1>
    <p class="acme-everything-php-array-hello__greeting">{{ greeting }}</p>
</section>
