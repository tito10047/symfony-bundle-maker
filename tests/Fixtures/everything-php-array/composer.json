{
    "name": "acme/everything-php-array-bundle",
    "description": "AcmeEverythingPhpArrayBundle for Symfony",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "doctrine",
        "symfony-ux"
    ],
    "authors": [
        {
            "name": "Jane Doe",
            "email": "jane@example.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/config": "^7.4.17 || ^8.1.5",
        "symfony/console": "^7.4.17 || ^8.1.5",
        "symfony/dependency-injection": "^7.4.17 || ^8.1.5",
        "symfony/framework-bundle": "^7.4.17 || ^8.1.5",
        "symfony/http-foundation": "^7.4.17 || ^8.1.5",
        "symfony/http-kernel": "^7.4.17 || ^8.1.5",
        "symfony/routing": "^7.4.17 || ^8.1.5",
        "symfony/stimulus-bundle": "^2.13 || ^3.0",
        "symfony/twig-bundle": "^7.4.17 || ^8.1.5",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.18 || ^3.0",
        "doctrine/orm": "^3.4",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "symfony/asset-mapper": "^7.4.17 || ^8.1.5",
        "symfony/browser-kit": "^7.4.17 || ^8.1.5",
        "symfony/error-handler": "^7.4.17 || ^8.1.5",
        "symfony/event-dispatcher": "^7.4.17 || ^8.1.5",
        "symfony/filesystem": "^7.4.17 || ^8.1.5",
        "symfony/translation": "^7.4.17 || ^8.1.5"
    },
    "conflict": {
        "doctrine/orm": "<3.4"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "To store the greetings with Doctrine ORM"
    },
    "autoload": {
        "psr-4": {
            "Acme\\EverythingPhpArrayBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Acme\\EverythingPhpArrayBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "qa": [
            "@test"
        ],
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "qa": "Runs every quality check",
        "test": "Runs the tests (PHPUnit)"
    }
}
