{
    "name": "acme/minimal-php-array-bundle",
    "description": "AcmeMinimalPhpArrayBundle for Symfony",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Jane Doe",
            "email": "jane@example.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/config": "^7.4.17 || ^8.1.5",
        "symfony/dependency-injection": "^7.4.17 || ^8.1.5",
        "symfony/http-kernel": "^7.4.17 || ^8.1.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "symfony/error-handler": "^7.4.17 || ^8.1.5",
        "symfony/filesystem": "^7.4.17 || ^8.1.5",
        "symfony/framework-bundle": "^7.4.17 || ^8.1.5"
    },
    "autoload": {
        "psr-4": {
            "Acme\\MinimalPhpArrayBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Acme\\MinimalPhpArrayBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "qa": [
            "@test"
        ],
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "qa": "Runs every quality check",
        "test": "Runs the tests (PHPUnit)"
    }
}
