{
    "name": "acme/php-kitchen-sink-bundle",
    "description": "AcmePhpKitchenSinkBundle for Symfony",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "kitchen-sink"
    ],
    "authors": [
        {
            "name": "Jane Doe",
            "email": "jane@example.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/config": "^7.4.17 || ^8.1.5",
        "symfony/dependency-injection": "^7.4.17 || ^8.1.5",
        "symfony/http-foundation": "^7.4.17 || ^8.1.5",
        "symfony/http-kernel": "^7.4.17 || ^8.1.5",
        "symfony/routing": "^7.4.17 || ^8.1.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "symfony/browser-kit": "^7.4.17 || ^8.1.5",
        "symfony/error-handler": "^7.4.17 || ^8.1.5",
        "symfony/filesystem": "^7.4.17 || ^8.1.5",
        "symfony/framework-bundle": "^7.4.17 || ^8.1.5"
    },
    "autoload": {
        "psr-4": {
            "Acme\\PhpKitchenSinkBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Acme\\PhpKitchenSinkBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "kitchen-sink": "echo kitchen-sink",
        "lint": [
            "@php -l src/",
            "@test"
        ],
        "qa": [
            "@test",
            "@lint"
        ],
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "kitchen-sink": "Checks the kitchen sink",
        "qa": "Runs every quality check",
        "test": "Runs the tests (PHPUnit)"
    }
}
