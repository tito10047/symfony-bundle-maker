{
    "name": "tito10047/symfony-bundle-maker",
    "description": "Composer plugin that generates a Symfony bundle following the official best practices",
    "license": "MIT",
    "type": "composer-plugin",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "skeleton",
        "composer-plugin"
    ],
    "authors": [
        {
            "name": "Jozef Môstka",
            "email": "jozef@mostka.sk"
        },
        {
            "name": "Yonel Ceruto",
            "email": "yonelceruto@gmail.com",
            "role": "Original author"
        }
    ],
    "require": {
        "php": ">=8.2",
        "composer-plugin-api": "^2.6"
    },
    "require-dev": {
        "composer/composer": "^2.6",
        "friendsofphp/php-cs-fixer": "^3.92",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/config": "^7.4 || ^8.1",
        "symfony/dependency-injection": "^7.4 || ^8.1",
        "symfony/http-kernel": "^7.4 || ^8.1",
        "symfony/routing": "^7.4 || ^8.1",
        "symfony/yaml": "^7.4 || ^8.1"
    },
    "conflict": {
        "marc-mabe/php-enum": "<4.4"
    },
    "autoload": {
        "psr-4": {
            "Tito10047\\BundleMaker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tito10047\\BundleMaker\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "class": "Tito10047\\BundleMaker\\Plugin"
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse",
        "qa": [
            "@cs",
            "@phpstan",
            "@test"
        ],
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "cs": "Checks coding standards (PHP-CS-Fixer, dry run)",
        "cs:fix": "Fixes coding standards (PHP-CS-Fixer)",
        "phpstan": "Runs static analysis (PHPStan, level max)",
        "qa": "Runs every quality check: coding standards, static analysis and tests",
        "test": "Runs the test suite (PHPUnit)"
    }
}
