{
    "name": "tito10047/symfony-bundle-maker",
    "description": "Composer plugin for Symfony bundles",
    "type": "composer-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Jozef Môstka",
            "email": "jozef@mostka.sk"
        },
        {
            "name": "Yonel Ceruto",
            "email": "yonelceruto@gmail.com",
            "role": "Original author"
        }
    ],
    "require": {
        "php": ">=8.1",
        "composer-plugin-api": "^2.3",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "composer/composer": "^2.6",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Tito10047\\BundleMaker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tito10047\\BundleMaker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "Tito10047\\BundleMaker\\Plugin"
    }
}
