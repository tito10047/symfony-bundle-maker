root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yaml,yml,neon}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[tests/Fixtures/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
